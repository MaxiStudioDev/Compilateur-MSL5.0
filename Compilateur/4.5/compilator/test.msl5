# ═══════════════════════════════════════════════════════
# 🧪 MSL5 BENCH v11.0 — Test registre + variables + GT/LT
# ═══════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────
# BENCH 1 — Variable simple
# let x = 10 → registre index 0 = 10
# Résultat attendu : D1 registre index 0 = 10
# ─────────────────────────────────────────────────────
let x = 10

# ─────────────────────────────────────────────────────
# BENCH 2 — ADD avec variable
# x + 5 = 15
# Résultat attendu : ALU = 15
# OpCode = 0x501 (ADD + READ + SM)
# D1 = 0 (CPU lit x depuis registre via SI)
# D2 = 5
# ─────────────────────────────────────────────────────
ADD x + 5

# ─────────────────────────────────────────────────────
# BENCH 3 — SUB avec variable
# x - 3 = 7
# Résultat attendu : ALU = 7
# ─────────────────────────────────────────────────────
SUB x 3

# ─────────────────────────────────────────────────────
# BENCH 4 — Deuxième variable
# let y = 20 → registre index 1 = 20
# ─────────────────────────────────────────────────────
let y = 20

# ─────────────────────────────────────────────────────
# BENCH 5 — ADD avec y
# y + 10 = 30
# Résultat attendu : ALU = 30
# ─────────────────────────────────────────────────────
ADD y 10

# ─────────────────────────────────────────────────────
# BENCH 6 — IF avec variable == nombre
# x == 10 → true → ADD 1 1 exécuté
# Résultat attendu : ALU = 2
# ─────────────────────────────────────────────────────
if x == 10 {
    ADD 1 1
}

# ─────────────────────────────────────────────────────
# BENCH 7 — IF avec variable == nombre faux
# x == 99 → false → ADD 99 99 NON exécuté
# ─────────────────────────────────────────────────────
if x == 99 {
    ADD 99 99
}

# ─────────────────────────────────────────────────────
# BENCH 8 — IF avec > 
# x > 5 → true → ADD 2 2 exécuté
# Résultat attendu : ALU = 4
# ─────────────────────────────────────────────────────
if x > 5 {
    ADD 2 2
}

# ─────────────────────────────────────────────────────
# BENCH 9 — IF avec > faux
# x > 99 → false → ADD 99 99 NON exécuté
# ─────────────────────────────────────────────────────
if x > 99 {
    ADD 99 99
}

# ─────────────────────────────────────────────────────
# BENCH 10 — IF avec <
# x < 99 → true → ADD 3 3 exécuté
# Résultat attendu : ALU = 6
# ─────────────────────────────────────────────────────
if x < 99 {
    ADD 3 3
}

# ─────────────────────────────────────────────────────
# BENCH 11 — IF avec < faux
# x < 1 → false → ADD 99 99 NON exécuté
# ─────────────────────────────────────────────────────
if x < 1 {
    ADD 99 99
}

# ─────────────────────────────────────────────────────
# BENCH 12 — Variable mise à jour
# let x = 42 → registre index 0 mis à jour = 42
# Résultat attendu : index 0 = 42 (même index que avant)
# ─────────────────────────────────────────────────────
let x = 42

# ─────────────────────────────────────────────────────
# BENCH 13 — ADD avec x mis à jour
# x + 8 = 50
# Résultat attendu : ALU = 50
# ─────────────────────────────────────────────────────
ADD x 8

# ─────────────────────────────────────────────────────
# BENCH 14 — OR avec variable
# y | 5 = 21
# Résultat attendu : ALU = 21
# ─────────────────────────────────────────────────────
OR y 5

# ─────────────────────────────────────────────────────
# BENCH 15 — AND avec variable
# y & 15 = 4
# Résultat attendu : ALU = 4
# ─────────────────────────────────────────────────────
AND y 15

# ─────────────────────────────────────────────────────
# BENCH 16 — XOR avec variable
# y ^ 5 = 17
# Résultat attendu : ALU = 17
# ─────────────────────────────────────────────────────
XOR y 5

# ─────────────────────────────────────────────────────
# BENCH 17 — Copie de variable
# let z = x → z = 42, registre index 2
# Résultat attendu : index 2 = 42
# ─────────────────────────────────────────────────────
let z = x

# ─────────────────────────────────────────────────────
# BENCH 18 — ADD avec z copié
# z + 8 = 50
# Résultat attendu : ALU = 50
# ─────────────────────────────────────────────────────
ADD z 8

# ─────────────────────────────────────────────────────
# BENCH 19 — Variable dans LOOP
# ADD x 1 exécuté 3 fois
# x = 42 donc 42 + 1 = 43 à chaque tour
# ─────────────────────────────────────────────────────
LOOP 3 {
    ADD x 1
}

# ─────────────────────────────────────────────────────
# BENCH 20 — IF + GT dans LOOP
# 3 tours, x > 5 → Out(1) allumée à chaque tour
# ─────────────────────────────────────────────────────
LOOP 3 {
    if x > 5 {
        Out(1).Set(1)
    }
}

# ─────────────────────────────────────────────────────
# BENCH 21 — IF + LT dans LOOP
# 3 tours, x < 99 → Out(2) allumée à chaque tour
# ─────────────────────────────────────────────────────
LOOP 3 {
    if x < 99 {
        Out(2).Set(1)
    }
}

# ─────────────────────────────────────────────────────
# BENCH 22 — Variable dans FOR
# ADD y 2 exécuté 4 fois
# y = 20 donc 20 + 2 = 22 à chaque tour
# ─────────────────────────────────────────────────────
FOR 0..4 {
    ADD y 2
}

# ─────────────────────────────────────────────────────
# BENCH 23 — REG READ brut
# Lit x depuis registre en sortie brute
# Résultat attendu : D1/D2 = contenu registre x
# ─────────────────────────────────────────────────────
reg read x

# ─────────────────────────────────────────────────────
# BENCH 24 — REG READ variable D1
# Lit y en sortie variable D1
# ─────────────────────────────────────────────────────
reg read y var

# ─────────────────────────────────────────────────────
# BENCH 25 — REG READ variable D2
# Lit z en sortie variable D2
# ─────────────────────────────────────────────────────
reg read z vard2

# ─────────────────────────────────────────────────────
# BENCH 26 — GPIO + variable
# Out(1) allumée puis ADD x 1
# ─────────────────────────────────────────────────────
Out(1).Set(1)
ADD x 1
Out(1).Set(0)

# ─────────────────────────────────────────────────────
# BENCH 27 — LOOP infini + BREAK avec variable
# ADD x 5 une fois puis BREAK
# Résultat attendu : ALU = 47 (42+5) puis stop
# ─────────────────────────────────────────────────────
loop {
    ADD x 5
    break
}

# ─────────────────────────────────────────────────────
# FIN DU BENCH v11.0
# ─────────────────────────────────────────────────────
STOP